  "repository": {
    "type": "git",
    "url": "git+https://github.com/unixlamadev-spec/lightningprox-mcp.git"
  },
  "homepage": "https://github.com/unixlamadev-spec/lightningprox-mcp#readme",
  "bugs": {
    "url": "https://github.com/unixlamadev-spec/lightningprox-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
