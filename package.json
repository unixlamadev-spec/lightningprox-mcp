    "test": "node --test test/tools.test.js",
    "smoke": "node scripts/smoke-live.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "bitcoin",
    "lightning",
    "l402",
    "ai",
    "claude",
    "gpt",
    "gemini",
    "sats",
    "payments",
    "autonomous-agents"
  ],
